<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram name="Luong du lieu DATN" id="datn-dataflow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Tieu de -->
        <mxCell id="title" value="Luồng dữ liệu vào hệ thống DATN (Conduit / AWS) — luồng hợp lệ (xanh) &amp; luồng truy cập sai bị chặn (đỏ)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=16;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="30" as="geometry" />
        </mxCell>

        <!-- ===================== LUONG HOP LE ===================== -->

        <!-- Nguoi dung -->
        <mxCell id="user" value="NGƯỜI DÙNG&#10;Trình duyệt — Vue3 SPA&#10;HTTPS → oanhlab.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="70" width="210" height="70" as="geometry" />
        </mxCell>

        <!-- CloudFront -->
        <mxCell id="cf" value="AWS CloudFront — CDN / điểm vào DUY NHẤT&#10;• ACM cert (HTTPS, redirect-to-https)&#10;• Shield Standard (chống DDoS L3/L4)&#10;• Chèn header bí mật X-Origin-Verify vào origin /api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="190" width="410" height="90" as="geometry" />
        </mxCell>

        <!-- WAF -->
        <mxCell id="waf" value="AWS WAF v2 (us-east-1)&#10;• Managed rules: SQLi / XSS / bad bots&#10;• rate-limit-login: 100 req / 5 phút / IP&#10;trên /api/users/login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="240" y="330" width="370" height="80" as="geometry" />
        </mxCell>

        <!-- Phan nhanh -->
        <mxCell id="branchS3" value="Path KHÔNG /api/*&#10;→ origin S3" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="460" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="branchApi" value="Path khớp /api/*&#10;→ origin API Gateway" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="460" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- S3 -->
        <mxCell id="s3" value="Amazon S3 (frontend tĩnh)&#10;• OAC — chỉ CloudFront đọc được&#10;• Mã hóa SSE-KMS&#10;• CF Function spa_router → index.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="240" height="100" as="geometry" />
        </mxCell>

        <!-- API Gateway -->
        <mxCell id="apigw" value="API Gateway (HTTP API v2)&#10;• Public nhưng bị khóa bằng&#10;  X-Origin-Verify&#10;• Chỉ CloudFront qua được&#10;  → chặn bypass WAF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="580" width="240" height="100" as="geometry" />
        </mxCell>

        <!-- Lambda -->
        <mxCell id="lambda" value="AWS Lambda — FastAPI&#10;• Middleware verify_origin: hmac.compare_digest header → thiếu/sai = 403&#10;• CORS middleware + xác thực JWT&#10;• Router /api: users, articles, profiles, comments, tags, health&#10;• VPC private subnet, IAM least-privilege" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="740" width="420" height="110" as="geometry" />
        </mxCell>

        <!-- DynamoDB -->
        <mxCell id="ddb" value="Amazon DynamoDB&#10;single-table — bảng &quot;conduit&quot;&#10;(qua VPC Gateway Endpoint, không ra internet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="470" y="900" width="340" height="80" as="geometry" />
        </mxCell>

        <!-- Mui ten hop le -->
        <mxCell id="e1" value="HTTPS request" style="endArrow=block;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" parent="1" source="user" target="cf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="viewer-request" style="endArrow=block;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" parent="1" source="cf" target="waf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="PASS" style="endArrow=block;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="waf" target="branchS3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="PASS" style="endArrow=block;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;exitX=0.75;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="waf" target="branchApi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" parent="1" source="branchS3" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="+ X-Origin-Verify" style="endArrow=block;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" parent="1" source="branchApi" target="apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="trả file tĩnh" style="endArrow=block;html=1;fontSize=11;strokeColor=#82b366;strokeWidth=2;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="user">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="invoke" style="endArrow=block;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" parent="1" source="apigw" target="lambda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="đọc / ghi" style="endArrow=block;startArrow=block;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" parent="1" source="lambda" target="ddb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== LUONG TRUY CAP SAI ===================== -->

        <!-- Ke tan cong -->
        <mxCell id="attacker" value="KẺ TẤN CÔNG / TRUY CẬP SAI&#10;(client độc hại, script, bot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#660000;strokeColor=#330000;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="70" width="300" height="80" as="geometry" />
        </mxCell>

        <!-- Badge chan 1: WAF -->
        <mxCell id="blk1" value="✗ CHẶN 403 — WAF&#10;SQLi/XSS, brute-force login&#10;(gửi qua CloudFront)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="320" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- Badge chan 3: S3 OAC -->
        <mxCell id="blk3" value="✗ CHẶN 403 — S3 OAC&#10;AccessDenied&#10;(truy cập thẳng URL bucket S3)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="595" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- Badge chan 2: Lambda verify_origin -->
        <mxCell id="blk2" value="✗ CHẶN 403 — Lambda verify_origin&#10;thiếu X-Origin-Verify&#10;(gọi thẳng API Gateway, né CloudFront+WAF)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="890" y="755" width="240" height="100" as="geometry" />
        </mxCell>

        <!-- Mui ten tan cong (do) -->
        <mxCell id="a1" value="1) Payload độc hại qua CloudFront" style="endArrow=block;html=1;fontSize=11;strokeColor=#CC0000;strokeWidth=2.5;dashed=1;" edge="1" parent="1" source="attacker" target="blk1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="2) Gọi thẳng endpoint API Gateway" style="endArrow=block;html=1;fontSize=11;strokeColor=#CC0000;strokeWidth=2.5;dashed=1;" edge="1" parent="1" source="attacker" target="blk2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="3) Truy cập thẳng URL bucket S3" style="endArrow=block;html=1;fontSize=11;strokeColor=#CC0000;strokeWidth=2.5;dashed=1;" edge="1" parent="1" source="attacker" target="blk3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Duong thuc thi (dotted xam): badge -.- thanh phan -->
        <mxCell id="d1" value="thực thi bởi WAF" style="endArrow=none;html=1;fontSize=10;strokeColor=#999999;dashed=1;dashPattern=1 4;" edge="1" parent="1" source="blk1" target="waf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="verify_origin" style="endArrow=none;html=1;fontSize=10;strokeColor=#999999;dashed=1;dashPattern=1 4;" edge="1" parent="1" source="blk2" target="lambda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="OAC bucket policy" style="endArrow=none;html=1;fontSize=10;strokeColor=#999999;dashed=1;dashPattern=1 4;" edge="1" parent="1" source="blk3" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== GHI CHU + LEGEND ===================== -->

        <mxCell id="note" value="Ghi chú bảo mật:&#10;• Mọi truy cập hợp lệ phải qua CloudFront — S3 và API Gateway KHÔNG cho truy cập trực tiếp.&#10;• Gọi thẳng API Gateway né WAF → thiếu X-Origin-Verify → Lambda trả 403 (chống bypass WAF).&#10;• Truy cập thẳng bucket S3 → OAC từ chối (403 AccessDenied).&#10;• Lambda → DynamoDB đi qua VPC Gateway Endpoint, không qua internet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="760" height="110" as="geometry" />
        </mxCell>

        <mxCell id="legendT" value="CHÚ THÍCH" style="text;html=1;fontStyle=1;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="900" y="1000" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legLine1" value="Luồng hợp lệ (cho phép)" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="940" y="1030" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legLine2" value="Luồng truy cập sai (bị chặn 403)" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="940" y="1060" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legArr1" style="endArrow=block;html=1;strokeColor=#2D7600;strokeWidth=2.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="1040" as="sourcePoint" />
            <mxPoint x="935" y="1040" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legArr2" style="endArrow=block;html=1;strokeColor=#CC0000;strokeWidth=2.5;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="1070" as="sourcePoint" />
            <mxPoint x="935" y="1070" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
