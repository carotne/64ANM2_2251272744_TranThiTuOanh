    {
      "module": "module.cloudfront",
      "mode": "managed",
      "type": "aws_cloudfront_function",
      "name": "spa_router",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:cloudfront::905418238956:function/oanhlab-prod-cf-spa-router",
            "code": "function handler(event) {\r\n  var request = event.request;\r\n  var uri = request.uri;\r\n  // never touch API requests\r\n  if (uri.startsWith('/api/')) { return request; }\r\n  // requests for real files (with an extension) pass through\r\n  var lastSegment = uri.substring(uri.lastIndexOf('/') + 1);\r\n  if (lastSegment.indexOf('.') !== -1) { return request; }\r\n  // everything else is a client-side route -\u003e serve the SPA shell\r\n  request.uri = '/index.html';\r\n  return request;\r\n}\r\n",
            "comment": "Rewrite SPA client-side routes to /index.html (S3 behavior only)",
            "etag": "ETVPDKIKX0DER",
            "id": "oanhlab-prod-cf-spa-router",
            "key_value_store_associations": [],
            "live_stage_etag": "ETVPDKIKX0DER",
            "name": "oanhlab-prod-cf-spa-router",
            "publish": true,
            "runtime": "cloudfront-js-2.0",
            "status": "DEPLOYED"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
        }
      ]
    },
